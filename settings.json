  ],
  
  // MATLAB
  "MATLAB.installPath": "D:\\Programs\\Miscellaneous\\MATLAB\\R2026a",
  "MATLAB.signIn": true,
  "MATLAB.startDebuggerAutomatically": true,
  "MATLAB.telemetry": false,

  // AI
    // Copilot
    "github.copilot.enable": {
      "*": true,
      "plaintext": false,
      "markdown": false,
      "scminput": false
    },
    "chat.viewSessions.orientation": "stacked",
    // Kilo Code
    "kilo-code.new.agentWorkStyle": "skipped",

  // VIM
  "vim.camelCaseMotion.enable": true,
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": false,
  "vim.useCtrlKeys": true,
  "vim.commandLineModeKeyBindings": [
    // Search use Ignore
    {
      "before": ["i", "o", "n"],
      "after": ["<Esc>"],
      "commands": [
        {
          "command": "toggle",
          "args": {
            "id": "useIgnoreFilesOn",
            "value": [
              { "search.useIgnoreFiles": true }
            ]
          }
        }
      ]
    },
    {
      "before": ["i", "o", "f", "f"],
      "after": ["<Esc>"],
      "commands": [
        {
          "command": "toggle",
          "args": {
            "id": "useIgnoreFilesOff",
            "value": [
              { "search.useIgnoreFiles": false }
            ]
          }
        }
      ]
    },
    // SCM sidebar
    {
      "before": ["g", "s"],
      "after": ["<Esc>"],
      "commands": [
        "workbench.view.scm",
      ]
    },
    // Git Graph
    {
      "before": ["g"],
      "after": ["<Esc>"],
      "commands": [
        "git-graph.view",
      ]
    },
    // log Viewer
    {
      "before": ["l", "o", "g"],
      "after": ["<Esc>"],
      "commands": [
        "workbench.view.extension.log-viewer",
      ]
    },
  ],
  "vim.normalModeKeyBindings": [
    // Escape replacement
    {
      "before": ["<c-j>"],
      "commands": ["extension.vim_escape"]
    },
  ],
  "vim.insertModeKeyBindings": [
    // Escape replacement
    {
      "before": ["<c-j>"],
      "commands": ["extension.vim_escape"]
    }
  ],
  "vim.visualModeKeyBindings": [ 
    // Word Part Left Select
    {
      "before": ["<c-a-h>"],
      "after": ["<leader>", "b"]
    }, 
    // Word Part Right Select,
    {
      "before": ["<c-a-l>"],
      "after": ["<leader>", "w"]
    }, 
    // Word Left Select,
    {
      "before": ["<a-h>"],
      "after": ["b"]
    }, 
    // Word Left Select,
    {
      "before": ["<a-l>"],
      "after": ["e"]
    }, 
    // Repeat indent after mouse selection,
    {
      "before": [">"],
      "after": [">", "g", "v"]
    }, 
    // Repeat outdent after mouse selection,
    {
      "before": ["<"],
      "after": ["<", "g", "v"]
    },
    // Paste and replace (without storing replaced text in buffer)
    {
      "before": ["<leader>", "p"],
      "after": ["\"", "_", "d", "p"]
    },
    // Escape replacement
    {
      "before": ["<c-j>"],
      "commands": ["extension.vim_escape"]
    },
  ],
  "vim.leader": "<space>",
  "vim.handleKeys": { // Regained Vanilla function    | Lost Vim function             | Reason                                              |
                      // ---------------------------- | ----------------------------- | --------------------------------------------------- |
    "<C-a>": false,   // Select all                   | Increment selected number     | simpy cw or ctrl + alt + a instead.                 |
    "<C-f>": false,   // find                         | Scroll down page              | I use my mouse instead for code browsing.           |
    "<C-e>": false,   // line comment                 | Scroll down 1 line            | I use my mouse instead for code browsing.           |
    "<C-k>": false,   // Quick Bar                    | Vim Digraphs (symbol insert)  | I use alt+numpad instead.                           |
    "<C-w>": false,   // Close tab                    | Change focused split window   | I use my mouse instead for code browsing.           |
    "<C-d>": false,   // Select Matching Words lines  | Scroll down 1/2 page          | I use my mouse instead for code browsing.           |
    "<C-x>": false,   // Cut selection                | Decrement selected number     | simply cw instead.                                  |
    "<C-c>": false,   // Copy selection               | Return to Normal Mode         | I use ctrl + j instead.                             |
    "<C-v>": false,   // Paste                        | Visual Block Mode             | Now its v + <ctrl + v> to enter visual block mode.  |
  },
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 9,
  "editor.cursorSurroundingLinesStyle": "all",

  // NEW
}
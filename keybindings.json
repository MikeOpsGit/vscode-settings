  // VIM MOVEMENT BINDINGS
    // * Horizontal Movement
    {
      "key": "ctrl+h",
      "command": "cursorLeft",
      "when": "textInputFocus && vim.mode == 'Insert'"
    },
    {
      "key": "ctrl+l",
      "command": "cursorRight",
      "when": "textInputFocus && vim.mode == 'Insert'"
    },
    {
      "key": "alt+h",
      "command": "cursorWordLeft",
      "when": "textInputFocus && !accessibilityModeEnabled && vim.mode != 'Visual'"
    },
    {
      "key": "alt+l",
      "command": "cursorWordEndRight",
      "when": "textInputFocus && !accessibilityModeEnabled && vim.mode != 'Visual'"
    },
    {
      "key":"ctrl+alt+h",
      "command": "cursorWordPartLeft",
      "when": "vim.mode != 'Visual'"
    },
    {
      "key":"ctrl+alt+l",
      "command": "cursorWordPartRight",
      "when": "vim.mode != 'Visual'"
    },

    // * Horizontal Selection
    {
      "key": "alt+h",
      "command": "vim.remap",
      "args": { "after": ["b"] },
      "when": "editorTextFocus && vim.mode == 'Visual'"
    },
    {
      "key": "alt+l",
      "command": "vim.remap",
      "args": { "after": ["e"] },
      "when": "editorTextFocus && vim.mode == 'Visual'"
    },
    {
      "key": "ctrl+alt+h",
      "command": "vim.remap",
      "args": { "after": ["<leader>", "b"], "recursive": true },
      "when": "editorTextFocus && vim.mode == 'Visual'"
    },
    {
      "key": "ctrl+alt+l",
      "command": "vim.remap",
      "args": { "after": ["<leader>", "w"], "recursive": true },
      "when": "editorTextFocus && vim.mode == 'Visual'"
    },

    // * Move Lines Up / Down
    {
      "key": "ctrl+alt+k",
      "command": "editor.action.moveLinesUpAction",
      "when": "editorTextFocus && !editorReadonly"
    },
    {
      "key": "ctrl+alt+j",
      "command": "editor.action.moveLinesDownAction"
    },

    // * Copy Lines Up / Down
    {
      "key": "ctrl+shift+alt+j",
      "command": "editor.action.copyLinesDownAction",
      "when": "editorTextFocus && !editorReadonly"
    },
    {
      "key": "ctrl+shift+alt+k",
      "command": "editor.action.copyLinesUpAction",
      "when": "editorTextFocus && !editorReadonly"
    },

    // * Removed Habits
    {
      "key": "escape",
      "command": "-extension.vim_escape",
      "when": "editorTextFocus && vim.active && !inDebugRepl"
    },
    
    // * Block Mode Rebind
    {
      "key": "ctrl+v",
      "command": "vim.remap",
      "args": { "after": ["<c-v>"] },
      "when": "editorTextFocus && vim.mode == 'Visual'"
    },
    
    // * Removed Keybinds
    {
      "key": "alt+j",
      "command": "-supermaven.newConversationTab"
    },


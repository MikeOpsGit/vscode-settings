// Place your key bindings in this file to override the defaults
[
  // * Miscellaneous Keybinds
  {
    "key": "shift+alt+k",
    "command": "list.expandSelectionDown",
    "when": "listFocus && listSupportsMultiselect && !inputFocus"
  },
  {
    "key": "alt+w",
    "command": "editor.debug.action.selectionToWatch"
  },

  // * Git
    // * Added
    {
      "key": "ctrl+alt+z",
      "command": "git.revertSelectedRanges",
      "when": "editorTextFocus && !operationInProgress && resourceScheme == 'file'"
    },
    {
    "key": "ctrl+alt+s",
    "command": "git.stageSelectedRanges",
    "when": "editorTextFocus && !operationInProgress && resourceScheme == 'file'"
    },
    {
      "key": "ctrl+shift+alt+s",
      "command": "git.unstageSelectedRanges",
      "when": "editorTextFocus && isInDiffEditor && isInDiffRightEditor && !operationInProgress && resourceScheme == 'git'"
    },
    // * Removed
    {
      "key": "ctrl+k ctrl+r",
      "command": "-git.revertSelectedRanges",
      "when": "editorTextFocus && !operationInProgress && resourceScheme == 'file'"
    },
    {
      "key": "ctrl+k ctrl+alt+s",
      "command": "-git.stageSelectedRanges",
      "when": "editorTextFocus && !operationInProgress && resourceScheme == 'file'"
    },
    {
      "key": "ctrl+k ctrl+n",
      "command": "-git.unstageSelectedRanges",
      "when": "editorTextFocus && isInDiffEditor && isInDiffRightEditor && !operationInProgress && resourceScheme == 'git'"
    },
    
  // * Commenting
    // * Added
    {
      "key": "ctrl+shift+e",
      "command": "editor.action.blockComment",
      "when": "editorTextFocus && !editorReadonly"
    },
    {
      "key": "ctrl+e",
      "command": "editor.action.commentLine",
      "when": "editorTextFocus && !editorReadonly"
    },

    // * Removed Default
    {
      "key": "shift+alt+a",
      "command": "-editor.action.blockComment",
      "when": "editorTextFocus && !editorReadonly"
    },
    {
      "key": "ctrl+shift+e",
      "command": "-workbench.action.quickOpenNavigatePreviousInFilePicker",
      "when": "inFilesPicker && inQuickOpen"
    },
    {
      "key": "ctrl+shift+e",
      "command": "-workbench.view.explorer",
      "when": "viewContainer.workbench.view.explorer.enabled"
    },
    {
      "key": "ctrl+/",
      "command": "-editor.action.commentLine",
      "when": "editorTextFocus && !editorReadonly"
    },
    {
      "key": "ctrl+e",
      "command": "-workbench.action.quickOpen"
    },
    {
      "key": "ctrl+e",
      "command": "-workbench.action.quickOpenNavigateNextInFilePicker",
      "when": "inFilesPicker && inQuickOpen"
    },

  // * VSCode GUI Specific
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpen"
  },
  {
    "key": "ctrl+shift+w",
    "command": "workbench.action.closeFolder",
    "when": "emptyWorkspaceSupport && workbenchState != 'empty'"
  },

  // * Browser like keybinds
    // * Added
    {
      "key": "ctrl+shift+n",
      "command": "workbench.action.duplicateWorkspaceInNewWindow"
    },
    {
      "key": "ctrl+tab",
      "command": "workbench.action.terminal.focusNext",
      "when": "terminalFocus"
    },
    {
      "key": "ctrl+shift+tab",
      "command": "workbench.action.terminal.focusPrevious",
      "when": "terminalFocus"
    },
    {
      "key": "ctrl+w",
      "command": "workbench.action.terminal.kill"
    },
    {
      "key": "ctrl+w",
      "command": "workbench.action.closeActiveEditor"
    },
    {
      "key": "ctrl+shift+t",
      "command": "workbench.action.reopenClosedEditor"
    },
    {
      "key": "ctrl+t",
      "command": "runCommands",
      "args": {
        "commands": [
          "workbench.action.focusActiveEditorGroup",
          "workbench.action.closeSidebar",
          "workbench.action.closePanel"        
        ]
      }
    },

    // * Removed
    {
      "key": "ctrl+f4",
      "command": "-workbench.action.closeActiveEditor"
    },
    {
      "key": "ctrl+t",
      "command": "-workbench.action.showAllSymbols"
    },
    {
      "key": "ctrl+t",
      "command": "-kilo-code.new.agentManager.newSideTerminal",
      "when": "kilo-code.new.agentManagerSideTerminalFocused && activeWebviewPanelId == 'kilo-code.new.AgentManagerPanel'"
    },
    {
      "key": "ctrl+t",
      "command": "-kilo-code.new.agentManager.newTab",
      "when": "!kilo-code.new.agentManagerSideTerminalFocused && activeWebviewPanelId == 'kilo-code.new.AgentManagerPanel'"
    },

